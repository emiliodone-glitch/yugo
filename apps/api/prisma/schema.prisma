// Yugo data model — section 9 of the requirements document.
// PostGIS note: locations are stored as lat/lng doubles and geo queries use
// PostGIS functions (ST_MakePoint(...)::geography) in raw SQL, so the Prisma
// schema stays portable while Discover still runs distance in the database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  MEMBER
  MODERATOR
  COMMUNITY_MANAGER
  SUPPORT
  FINANCE
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  PAUSED
  SUSPENDED
  BANNED
  DELETION_PENDING
  DELETED
}

enum Gender {
  MALE
  FEMALE
}

enum Intention {
  MARRIAGE
  FRIENDSHIP
  BOTH
}

enum Openness {
  SAME
  AFFINE
  ALL
}

enum Attendance {
  WEEKLY
  BIWEEKLY
  MONTHLY
  OCCASIONAL
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum VerificationMethod {
  OTP
  SELFIE
  CHURCH_CODE
  LEADER_CONFIRMATION
}

enum ModerationStatus {
  PENDING
  APPROVED
  HELD
  REJECTED
}

enum MatchStatus {
  ACTIVE
  ENDED
}

/// Stages a bond goes through. The product promises "relación con propósito de
/// matrimonio"; a connection that can only be ACTIVE or ENDED cannot express
/// that. A couple declares each step together, and the step changes what the
/// app does — most importantly, NOVIAZGO takes both of them out of Descubrir.
enum RelationshipStage {
  KNOWING
  INTENTIONAL_FRIENDSHIP
  COURTSHIP
  ENGAGED
  /// The outcome the product exists for. The wedding happens outside the app;
  /// declaring it inside is what lets Yugo measure whether it kept its
  /// promise, instead of measuring revenue and calling that success.
  MARRIED
}

enum StoryStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  REJECTED
}

/// Historia de una pareja que se casó.
///
/// Nothing else Yugo publishes is worth as much as this, and nothing else is
/// as easy to fake. So: both people consent, the church is named, and a human
/// reviews it before it is public. A story nobody can verify is marketing;
/// a story a congregation stands behind is a reason to trust the product.
model Story {
  id        String      @id @default(cuid())
  matchId   String?     @unique
  match     Match?      @relation(fields: [matchId], references: [id], onDelete: SetNull)

  /// Kept denormalised on purpose: a story outlives the accounts behind it,
  /// and a couple who deletes their profiles does not un-marry.
  names       String
  churchNames String
  city        String?
  marriedAt   DateTime
  /// Cómo se conocieron y qué quieren decirle a quien está empezando.
  body        String
  photoKey    String?

  status     StoryStatus @default(DRAFT)
  /// Consentimiento de los dos, sin el cual no se publica nunca.
  consentAId Boolean     @default(false)
  consentBId Boolean     @default(false)
  submittedById String?
  reviewedById  String?
  reviewNote    String?

  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([status, publishedAt])
}

enum AccompanimentStatus {
  /// The couple invited a mentor; waiting on consent.
  INVITED
  /// Both members and the mentor agreed. Only now can the mentor see anything.
  ACTIVE
  DECLINED
  ENDED
}

/// Acompañamiento: a married couple from the church walks alongside a bond.
///
/// The invariant that makes this defensible: the mentor sees the bond and its
/// stage, never a single message. Not "we did not build that screen" —
/// AccompanimentService has no path to a conversation at all, and a test
/// proves a mentor is refused on the chat endpoints.
///
/// Consent is from all three and revocable by any of them. A bond is not the
/// property of whoever invited the mentor.
model Accompaniment {
  id       String             @id @default(cuid())
  matchId  String
  match    Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  mentorId String
  mentor   User               @relation("Mentor", fields: [mentorId], references: [id], onDelete: Cascade)
  status   AccompanimentStatus @default(INVITED)

  /// Which of the couple sent the invitation.
  invitedById String
  /// Consent recorded per member, so one cannot enrol the other.
  consentAId  Boolean   @default(false)
  consentBId  Boolean   @default(false)
  mentorAcceptedAt DateTime?

  createdAt DateTime  @default(now())
  activeAt  DateTime?
  endedAt   DateTime?
  endedById String?

  @@unique([matchId, mentorId])
  @@index([mentorId, status])
}

/// A member who offers to accompany couples, with the code they hand out.
///
/// Requires a level-3 endorsement: the church vouches for them before anyone
/// trusts them with a couple. `spouseName` is free text because the spouse of
/// a mentoring couple often is not on Yugo, and pretending otherwise would
/// either block real couples or invent accounts.
model MentorProfile {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String   @unique
  spouseName String?
  marriedSince Int?
  bio        String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

/// Append-only record of every agreed stage change (RF-ADM-11 in spirit):
/// the couple, their accompaniment and support can all see how a bond moved.
model RelationshipStageChange {
  id         String            @id @default(cuid())
  matchId    String
  match      Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  fromStage  RelationshipStage?
  toStage    RelationshipStage
  proposedById String
  acceptedById String
  createdAt  DateTime          @default(now())

  @@index([matchId, createdAt])
}

enum GroupType {
  OPEN
  APPROVAL
  OFFICIAL
}

enum GroupStatus {
  PENDING
  ACTIVE
  ARCHIVED
  CLOSED
}

enum GroupRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum ReactionType {
  AMEN
  PRAYING
  LIKE
}

enum EventType {
  CULTO_ESPECIAL
  VIGILIA
  RETIRO
  CONCIERTO
  CONGRESO
  ACTIVIDAD_SOCIAL
  SERVICIO_COMUNITARIO
}

enum EventStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  FINISHED
  REJECTED
}

enum EventAttendanceStatus {
  GOING
  INTERESTED
  /// Wants to come to a full encuentro; moves up when somebody cancels.
  /// Telling a person "no" and forgetting them is how a congregation loses
  /// them; telling them "you are third" is how it fills a room.
  WAITLIST
}

/// Who a church convokes. An encuentro convoked by the singles ministry is a
/// different thing from a Sunday service, and conflating them means the
/// ministry cannot see whether its own work is reaching anyone.
enum EventAudience {
  CONGREGATION
  SINGLES
}

enum ReportTargetType {
  PROFILE
  MESSAGE
  POST
  EVENT
  GROUP
}

enum ReportCategory {
  INAPPROPRIATE
  SCAM
  FAKE_IDENTITY
  HARASSMENT
  MISLEADING
  UNDERAGE
}

enum ModerationPriority {
  CRITICAL
  HIGH
  NORMAL
}

enum ModerationCaseStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  ESCALATED
}

enum ModerationCaseKind {
  REPORT
  AI_HELD
  APPEAL
}

enum SanctionType {
  WARNING
  SUSPENSION
  BAN
  CONTENT_REMOVAL
}

enum AppealStatus {
  OPEN
  ACCEPTED
  REJECTED
}

enum SubscriptionTier {
  PLUS
  ORO
}

enum SubscriptionPlan {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum SubscriptionChannel {
  STRIPE
  AZUL
  APP_STORE
  GOOGLE_PLAY
  PROMO
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUND_REQUESTED
  REFUNDED
}

enum ChurchStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum ChurchUserRole {
  ADMIN
  EVENT_EDITOR
}

enum EndorsementRequestStatus {
  PENDING
  CONFIRMED
  DECLINED
  EXPIRED
}

enum NotificationCategory {
  CONNECTION
  RELATIONSHIP
  ACCOMPANIMENT
  MESSAGE
  INTEREST
  EVENT
  GROUP
  VERIFICATION
  MODERATION
  SUBSCRIPTION
}

// ---------------------------------------------------------------------------
// Identity & profile
// ---------------------------------------------------------------------------

model User {
  id                 String     @id @default(cuid())
  email              String?    @unique
  phone              String?    @unique
  passwordHash       String?
  googleId           String?    @unique
  appleId            String?    @unique
  role               UserRole   @default(MEMBER)
  status             UserStatus @default(ACTIVE)
  birthDate          DateTime
  gender             Gender
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  covenantAcceptedAt DateTime?
  covenantVersion    String?
  twoFactorEnabled   Boolean    @default(false)
  twoFactorSecret    String?
  lastActiveAt       DateTime   @default(now())
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  pausedAt           DateTime?
  deletionRequestedAt DateTime?
  deletedAt          DateTime?

  profile              Profile?
  photos               Photo[]
  verifications        Verification[]
  sentInterests        Interest[]           @relation("InterestFrom")
  receivedInterests    Interest[]           @relation("InterestTo")
  passes               Pass[]               @relation("PassFrom")
  passedBy             Pass[]               @relation("PassTo")
  savedProfiles        SavedProfile[]       @relation("SavedFrom")
  savedBy              SavedProfile[]       @relation("SavedTo")
  matchesA             Match[]              @relation("MatchA")
  matchesB             Match[]              @relation("MatchB")
  mentorProfile        MentorProfile?
  accompanying         Accompaniment[]      @relation("Mentor")
  messages             Message[]
  groupMemberships     GroupMember[]
  groupJoinRequests    GroupJoinRequest[]
  posts                Post[]
  comments             Comment[]
  reactions            Reaction[]
  eventAttendances     EventAttendance[]
  reportsMade          Report[]             @relation("Reporter")
  reportsReceived      Report[]             @relation("ReportedUser")
  sanctions            Sanction[]
  appeals              Appeal[]
  subscriptions        Subscription[]
  payments             Payment[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  quietHours           NotificationQuietHours?
  profileViewsMade     ProfileView[]        @relation("Viewer")
  profileViewsReceived ProfileView[]        @relation("Viewed")
  travelLocations      TravelLocation[]
  churchMemberships    ChurchUser[]
  refreshTokens        RefreshToken[]
  blocksMade           Block[]              @relation("Blocker")
  blocksReceived       Block[]              @relation("Blocked")
  endorsementRequests  EndorsementRequest[]
  moderationCasesAssigned ModerationCase[]  @relation("Assignee")

  @@index([status, lastActiveAt])
}

model Profile {
  userId          String     @id
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  city            String?
  province        String?
  occupation      String?
  education       String?
  bio             String?
  testimony       String?
  verse           String?
  denominationId  String?
  denomination    Denomination? @relation(fields: [denominationId], references: [id])
  churchId        String?
  church          Church?    @relation(fields: [churchId], references: [id])
  churchFreeText  String?
  yearsInFaith    Int?
  attendance      Attendance?
  intention       Intention  @default(BOTH)
  openness        Openness   @default(AFFINE)
  hasChildren     Boolean?
  lat             Float?
  lng             Float?
  completeness    Int        @default(0)
  // Mandatory mutual age range (RF-DES-11): span >= 3, ageMin >= 18.
  ageMin          Int
  ageMax          Int
  maxDistanceKm   Int        @default(100)
  prefIntention   Intention?
  prefWithChildren String?   // ANY | WITH | WITHOUT
  prefMinVerification Int    @default(1)
  // Opt-in privacy control (RF-SEG-07): when on, viewers read a range
  // ("5–10 km") instead of the exact distance.
  hideExactDistance Boolean  @default(false)
  invisibleMode   Boolean    @default(false)
  showOroBadge    Boolean    @default(false)
  allowEventPresenceVisible Boolean @default(true)
  featuredUntil   DateTime?
  updatedAt       DateTime   @updatedAt

  serviceAreas ProfileServiceArea[]
  answers      ProfileAnswer[]

  @@index([denominationId])
  @@index([churchId])
  @@index([intention])
  @@index([ageMin, ageMax])
}

model ProfileAnswer {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [userId], onDelete: Cascade)
  question  String
  answer    String

  @@unique([profileId, question])
}

model Photo {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageKey       String
  position         Int              @default(0)
  moderationStatus ModerationStatus @default(PENDING)
  moderationRisk   Float?
  createdAt        DateTime         @default(now())

  @@index([userId, position])
}

model ServiceArea {
  id     String @id @default(cuid())
  slug   String @unique
  name   String
  active Boolean @default(true)

  profiles ProfileServiceArea[]
}

model ProfileServiceArea {
  profileId     String
  serviceAreaId String
  profile       Profile     @relation(fields: [profileId], references: [userId], onDelete: Cascade)
  serviceArea   ServiceArea @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)

  @@id([profileId, serviceAreaId])
}

// Oro: who viewed my profile (RF-DES-15)
model ProfileView {
  id       String   @id @default(cuid())
  viewerId String
  viewedId String
  viewer   User     @relation("Viewer", fields: [viewerId], references: [id], onDelete: Cascade)
  viewed   User     @relation("Viewed", fields: [viewedId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@index([viewedId, viewedAt])
}

// Oro: travel mode (RF-DES-14)
model TravelLocation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city        String
  country     String?
  lat         Float
  lng         Float
  activeUntil DateTime
  createdAt   DateTime @default(now())

  @@index([userId, activeUntil])
}

// ---------------------------------------------------------------------------
// Catalogs: denominations & affinity matrix
// ---------------------------------------------------------------------------

model Denomination {
  id     String  @id @default(cuid())
  slug   String  @unique
  name   String
  family String
  active Boolean @default(true)

  profiles   Profile[]
  churches   Church[]
  affinitiesA DenominationAffinity[] @relation("AffinityA")
  affinitiesB DenominationAffinity[] @relation("AffinityB")
}

// Symmetric matrix, value 0–100, administrable (RF-ADM-07). Stored once per
// unordered pair (aId < bId enforced in service layer).
model DenominationAffinity {
  aId    String
  bId    String
  value  Int
  a      Denomination @relation("AffinityA", fields: [aId], references: [id], onDelete: Cascade)
  b      Denomination @relation("AffinityB", fields: [bId], references: [id], onDelete: Cascade)

  @@id([aId, bId])
}

// ---------------------------------------------------------------------------
// Churches, endorsement (level 3) & verification
// ---------------------------------------------------------------------------

model Church {
  id             String       @id @default(cuid())
  name           String
  denominationId String?
  denomination   Denomination? @relation(fields: [denominationId], references: [id])
  address        String?
  city           String?
  province       String?
  lat            Float?
  lng            Float?
  status         ChurchStatus @default(PENDING)
  contactName    String?
  contactEmail   String?
  socialLinks    Json?
  docsKeys       Json?
  directPublish  Boolean      @default(false) // trusted churches skip event review (RF-EVE-02)
  createdAt      DateTime     @default(now())
  approvedAt     DateTime?

  users             ChurchUser[]
  events            Event[]
  officialGroup     Group?
  endorsementCodes  EndorsementCode[]
  endorsementRequests EndorsementRequest[]
  verifications     Verification[]
  profiles          Profile[]
}

model ChurchUser {
  id       String         @id @default(cuid())
  churchId String
  userId   String
  role     ChurchUserRole @default(EVENT_EDITOR)
  church   Church         @relation(fields: [churchId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([churchId, userId])
}

// Single-use codes, 30-day expiry (RF-VER-02)
model EndorsementCode {
  id        String    @id @default(cuid())
  churchId  String
  church    Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  code      String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  usedById  String?
  revokedAt DateTime?

  @@index([churchId, usedAt])
}

// Member asks a leader to endorse them (RF-VER-03)
model EndorsementRequest {
  id          String                   @id @default(cuid())
  userId      String
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  churchId    String
  church      Church                   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  leaderEmail String?
  leaderName  String?
  attendsSince Int?
  status      EndorsementRequestStatus @default(PENDING)
  createdAt   DateTime                 @default(now())
  resolvedAt  DateTime?

  @@index([churchId, status])
}

model Verification {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  level        Int // 1 contact · 2 identity · 3 church
  method       VerificationMethod
  status       VerificationStatus @default(PENDING)
  evidenceKey  String? // selfie storage key
  similarity   Float?
  livenessPassed Boolean?
  churchId     String?
  church       Church?            @relation(fields: [churchId], references: [id])
  reviewedById String?
  reviewNote   String?
  revokeReason String?
  priority     Boolean            @default(false) // Oro <4h SLA (6.9)
  createdAt    DateTime           @default(now())
  resolvedAt   DateTime?
  expiresAt    DateTime?

  @@index([status, priority, createdAt])
  @@index([userId, level, status])
}

// ---------------------------------------------------------------------------
// Discover: interests, passes, saved, matches, chat
// ---------------------------------------------------------------------------

model Interest {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  from       User     @relation("InterestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to         User     @relation("InterestTo", fields: [toUserId], references: [id], onDelete: Cascade)
  message    String? // Plus 140 / Oro 300 (RF-DES-07)
  seenAt     DateTime?
  createdAt  DateTime @default(now())

  @@unique([fromUserId, toUserId])
  @@index([toUserId, createdAt])
}

model Pass {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  from       User     @relation("PassFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to         User     @relation("PassTo", fields: [toUserId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime // hidden for 30 days (7.2)
  undoneAt   DateTime?

  @@unique([fromUserId, toUserId])
  @@index([fromUserId, expiresAt])
}

model SavedProfile {
  fromUserId String
  toUserId   String
  from       User     @relation("SavedFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to         User     @relation("SavedTo", fields: [toUserId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([fromUserId, toUserId])
}

model Block {
  blockerId String
  blockedId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
}

// Ordered pair: userAId < userBId (enforced in service layer)
model Match {
  id        String      @id @default(cuid())
  userAId   String
  userBId   String
  userA     User        @relation("MatchA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User        @relation("MatchB", fields: [userBId], references: [id], onDelete: Cascade)
  status    MatchStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  endedAt   DateTime?
  endedById String?

  /// Current stage, only ever set once both people agreed.
  stage          RelationshipStage @default(KNOWING)
  stageChangedAt DateTime?
  /// A proposal in flight: who suggested which stage, and when.
  proposedStage     RelationshipStage?
  proposedById      String?
  proposedAt        DateTime?

  conversation    Conversation?
  stageHistory    RelationshipStageChange[]
  accompaniments  Accompaniment[]
  story           Story?

  @@unique([userAId, userBId])
  @@index([userAId, status])
  @@index([userBId, status])
}

model Conversation {
  id         String    @id @default(cuid())
  matchId    String    @unique
  match      Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  archivedByA Boolean  @default(false)
  archivedByB Boolean  @default(false)

  messages Message[]
}

model Message {
  id               String           @id @default(cuid())
  conversationId   String
  conversation     Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body             String
  moderationStatus ModerationStatus @default(PENDING)
  moderationRisk   Float?
  moderationCategories Json?
  sentAt           DateTime         @default(now())
  deliveredAt      DateTime?
  readAt           DateTime?

  @@index([conversationId, sentAt])
  @@index([moderationStatus, sentAt])
}

// ---------------------------------------------------------------------------
// Community: groups, posts, prayer, activities
// ---------------------------------------------------------------------------

model GroupCategory {
  id     String  @id @default(cuid())
  slug   String  @unique
  name   String
  active Boolean @default(true)

  groups Group[]
}

model Group {
  id          String      @id @default(cuid())
  name        String
  description String?
  coverKey    String?
  categoryId  String?
  category    GroupCategory? @relation(fields: [categoryId], references: [id])
  city        String?
  type        GroupType   @default(OPEN)
  status      GroupStatus @default(PENDING)
  ownerId     String?
  churchId    String?     @unique
  church      Church?     @relation(fields: [churchId], references: [id])
  createdAt   DateTime    @default(now())
  lastPostAt  DateTime?
  archivedAt  DateTime?

  members    GroupMember[]
  posts      Post[]
  activities GroupActivity[]
  joinRequests GroupJoinRequest[]

  @@index([status, type])
}

// RF-COM-02: groups of type APPROVAL queue join requests for their admins.
model GroupJoinRequest {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String?
  status    EndorsementRequestStatus @default(PENDING)
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  resolvedById String?

  @@unique([groupId, userId])
  @@index([groupId, status])
}

model GroupMember {
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  mutedUntil DateTime?
  joinedAt DateTime  @default(now())
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

model Post {
  id               String           @id @default(cuid())
  groupId          String
  group            Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId         String
  author           User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body             String
  imageKey         String?
  isPrayerRequest  Boolean          @default(false)
  answeredAt       DateTime? // prayer marked as answered (RF-COM-05)
  moderationStatus ModerationStatus @default(PENDING)
  moderationRisk   Float?
  createdAt        DateTime         @default(now())

  comments  Comment[]
  reactions Reaction[]

  @@index([groupId, createdAt])
}

model Comment {
  id               String           @id @default(cuid())
  postId           String
  post             Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId         String
  author           User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body             String
  moderationStatus ModerationStatus @default(PENDING)
  createdAt        DateTime         @default(now())

  @@index([postId, createdAt])
}

model Reaction {
  postId    String
  userId    String
  type      ReactionType
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@id([postId, userId, type])
}

model GroupActivity {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title     String
  startsAt  DateTime
  place     String?
  createdAt DateTime @default(now())

  attendances ActivityAttendance[]

  @@index([groupId, startsAt])
}

model ActivityAttendance {
  activityId String
  userId     String
  activity   GroupActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@id([activityId, userId])
}

// ---------------------------------------------------------------------------
// Events
// ---------------------------------------------------------------------------

model Event {
  id          String      @id @default(cuid())
  churchId    String
  church      Church      @relation(fields: [churchId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        EventType
  startsAt    DateTime
  endsAt      DateTime?
  address     String?
  city        String?
  lat         Float?
  lng         Float?
  capacity    Int?
  /// Convocado por la congregación, y para quién.
  audience    EventAudience @default(CONGREGATION)
  costAmount  Decimal?    @db.Decimal(10, 2)
  costCurrency String?
  externalUrl String?
  imageKey    String?
  status      EventStatus @default(DRAFT)
  featured    Boolean     @default(false)
  qrToken     String?     @unique
  reviewNote  String?
  createdAt   DateTime    @default(now())
  publishedAt DateTime?

  attendances EventAttendance[]

  @@index([status, startsAt])
  @@index([churchId, status])
}

model EventAttendance {
  eventId     String
  userId      String
  status      EventAttendanceStatus
  event       Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminderSentAt DateTime?
  checkedInAt DateTime?
  createdAt   DateTime              @default(now())

  @@id([eventId, userId])
  @@index([userId, status])
  /// The waitlist is served in the order people joined it, so that ordering
  /// has to be cheap to read.
  @@index([eventId, status, createdAt])
}

// ---------------------------------------------------------------------------
// Safety: reports, moderation cases, sanctions, appeals
// ---------------------------------------------------------------------------

model Report {
  id         String           @id @default(cuid())
  reporterId String
  reporter   User             @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType ReportTargetType
  targetId   String
  targetUserId String?
  targetUser User?            @relation("ReportedUser", fields: [targetUserId], references: [id])
  category   ReportCategory
  details    String?
  evidence   Json? // e.g. captured message history (RF-SEG-03)
  createdAt  DateTime         @default(now())

  case ModerationCase?

  @@index([targetUserId, createdAt])
}

model ModerationCase {
  id          String               @id @default(cuid())
  kind        ModerationCaseKind
  priority    ModerationPriority   @default(NORMAL)
  status      ModerationCaseStatus @default(OPEN)
  reportId    String?              @unique
  report      Report?              @relation(fields: [reportId], references: [id])
  messageId   String?
  postId      String?
  photoId     String?
  subjectUserId String?
  assigneeId  String?
  assignee    User?                @relation("Assignee", fields: [assigneeId], references: [id])
  internalNotes Json?
  decision    String?
  decisionReason String?
  slaDueAt    DateTime?
  createdAt   DateTime             @default(now())
  resolvedAt  DateTime?

  sanctions Sanction[]
  appeals   Appeal[]

  @@index([status, priority, createdAt])
}

model Sanction {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId    String?
  case      ModerationCase? @relation(fields: [caseId], references: [id])
  type      SanctionType
  days      Int?
  reason    String
  createdById String?
  createdAt DateTime     @default(now())
  until     DateTime?
  liftedAt  DateTime?

  @@index([userId, createdAt])
}

model Appeal {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId    String
  case      ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  body      String
  status    AppealStatus @default(OPEN)
  createdAt DateTime     @default(now())
  resolvedAt DateTime?
}

// ---------------------------------------------------------------------------
// Monetization
// ---------------------------------------------------------------------------

model Subscription {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier       SubscriptionTier
  plan       SubscriptionPlan
  channel    SubscriptionChannel
  status     SubscriptionStatus  @default(ACTIVE)
  startsAt   DateTime
  endsAt     DateTime
  canceledAt DateTime?
  // Downgrade scheduled for period end (RF-PLU-07)
  downgradeToTier SubscriptionTier?
  externalId String?
  promoCodeId String?
  promoCode  PromoCode?          @relation(fields: [promoCodeId], references: [id])
  createdAt  DateTime            @default(now())

  payments Payment[]

  @@index([userId, status, endsAt])
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  amount         Decimal       @db.Decimal(10, 2)
  currency       String
  provider       SubscriptionChannel
  providerRef    String?
  status         PaymentStatus @default(PENDING)
  refundReason   String?
  refundApprovedById String? // first approval
  refundSecondApprovedById String? // double approval (RF-ADM-09)
  createdAt      DateTime      @default(now())

  @@index([userId, createdAt])
}

model PromoCode {
  id          String   @id @default(cuid())
  code        String   @unique
  tier        SubscriptionTier
  trialDays   Int
  maxUses     Int?
  usedCount   Int      @default(0)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  subscriptions Subscription[]
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  title     String
  body      String
  data      Json?
  createdAt DateTime             @default(now())
  readAt    DateTime?
  pushedAt  DateTime?

  @@index([userId, createdAt])
}

model NotificationPreference {
  userId   String
  category NotificationCategory
  push     Boolean @default(true)
  email    Boolean @default(false)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
}

/// RF-NOT-02: quiet hours, stored as whole hours in America/Santo_Domingo.
/// A push raised inside the window is held until it closes, never dropped.
model NotificationQuietHours {
  userId    String  @id
  enabled   Boolean @default(true)
  startHour Int     @default(22)
  endHour   Int     @default(7)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Auth infrastructure
// ---------------------------------------------------------------------------

model OtpCode {
  id         String   @id @default(cuid())
  identifier String // email or phone
  codeHash   String
  purpose    String // REGISTER | LOGIN | RESET | LEADER_CONFIRM
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([identifier, purpose, createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  deviceInfo String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

// ---------------------------------------------------------------------------
// System: settings, legal content, audit
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model LegalDocument {
  id        String   @id @default(cuid())
  kind      String // COVENANT | TERMS | PRIVACY | SAFETY_TIPS
  version   String
  body      Json
  createdAt DateTime @default(now())
  activeFrom DateTime @default(now())

  @@unique([kind, version])
}

// Append-only: no API route updates or deletes rows (RF-ADM-11).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
