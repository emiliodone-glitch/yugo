{
  "expo": {
    "name": "Yugo",
    "slug": "yugo",
    "version": "0.1.0",
    "scheme": "yugo",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF8F3",
    "splash": {
      "backgroundColor": "#22315C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "do.yugo.app"
    },
    "android": {
      "package": "do.yugo.app",
      "adaptiveIcon": {
        "backgroundColor": "#22315C"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Yugo usa tus fotos para que elijas las de tu perfil.",
          "cameraPermission": "Yugo usa la cámara para tu foto de perfil y la selfie de verificación."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
