{
  "expo": {
    "name": "Yugo",
    "slug": "yugo",
    "version": "0.1.0",
    "scheme": "yugo",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF8F3",
    "splash": {
      "backgroundColor": "#22315C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "do.yugo.app",
      "associatedDomains": ["applinks:yugoweb-production.up.railway.app"]
    },
    "android": {
      "package": "do.yugo.app",
      "adaptiveIcon": {
        "backgroundColor": "#22315C"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "yugoweb-production.up.railway.app",
              "pathPrefix": "/e"
            },
            {
              "scheme": "https",
              "host": "yugoweb-production.up.railway.app",
              "pathPrefix": "/eventos"
            },
            {
              "scheme": "https",
              "host": "yugoweb-production.up.railway.app",
              "pathPrefix": "/comunidad"
            },
            {
              "scheme": "https",
              "host": "yugoweb-production.up.railway.app",
              "pathPrefix": "/iglesias/invitacion"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Yugo usa tus fotos para que elijas las de tu perfil.",
          "cameraPermission": "Yugo usa la cámara para tu foto de perfil y la selfie de verificación."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#22315C"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Yugo usa la cámara para leer el QR de entrada de los eventos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "notification": {
      "iosDisplayInForeground": true,
      "color": "#22315C"
    }
  }
}
