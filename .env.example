# ============================================================
# Yugo — environment template. Copy to .env and fill in values.
# Never commit real secrets.
# ============================================================

# --- Core ---
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- Database (PostgreSQL 16 + PostGIS; docker compose default) ---
DATABASE_URL=postgresql://yugo:yugo@localhost:5432/yugo?schema=public

# --- Redis (sessions, daily limits, queues, discover cache) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d
# OTP provider: "console" logs codes locally; "twilio"/"smtp" in production
OTP_PROVIDER=console

# --- Object storage (S3 compatible: MinIO local, R2/S3 in production) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=yugo-media
S3_ACCESS_KEY=yugo
S3_SECRET_KEY=yugo-secret
S3_SIGNED_URL_TTL=900

# --- Text moderation (Anthropic). Empty key => local stub classifier ---
ANTHROPIC_API_KEY=
MODERATION_TEXT_MODEL=claude-haiku-4-5-20251001
# Image moderation adapter: "stub" (dev) or "external"
IMAGE_MODERATION_PROVIDER=stub
IMAGE_MODERATION_URL=

# --- Icebreakers (optional AI generation; template fallback always on) ---
ICEBREAKER_AI_ENABLED=false

# --- Push notifications (Expo / FCM) ---
EXPO_ACCESS_TOKEN=
FCM_PROJECT_ID=

# --- Payments ---
PAYMENT_PROVIDER=stub
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AZUL_MERCHANT_ID=
AZUL_AUTH_KEY=
APPSTORE_SHARED_SECRET=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# --- Email (Mailpit local / Resend or SMTP in production) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Yugo <hola@yugo.do>"
RESEND_API_KEY=

# --- Timezone for daily limits (RF-DES-05) ---
APP_TIMEZONE=America/Santo_Domingo

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# Demo mode renders the full UI with seeded fixtures when the API is offline
NEXT_PUBLIC_DEMO_MODE=true

# --- Mobile (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_DEMO_MODE=true
