# ============================================================
# Yugo — environment template. Copy to .env and fill in values.
# Never commit real secrets.
# ============================================================

# --- Core ---
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- Database (PostgreSQL 16 + PostGIS; docker compose default) ---
DATABASE_URL=postgresql://yugo:yugo@localhost:5432/yugo?schema=public

# --- Redis (sessions, daily limits, queues, discover cache) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d
# OTP provider: "console" logs codes locally; "twilio"/"smtp" in production
OTP_PROVIDER=console

# --- Social sign-in (RF-AUT-02). Audience of the id_token we verify ---
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# --- Object storage (S3 compatible: MinIO local, R2/S3 in production) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=yugo-media
S3_ACCESS_KEY=yugo
S3_SECRET_KEY=yugo-secret
S3_SIGNED_URL_TTL=900

# --- Text moderation (Anthropic). Empty key => local stub classifier ---
ANTHROPIC_API_KEY=
MODERATION_TEXT_MODEL=claude-haiku-4-5-20251001
# Image moderation adapter: "stub" (dev) or "external"
IMAGE_MODERATION_PROVIDER=stub
IMAGE_MODERATION_URL=
# Comparación facial para la verificación de identidad (RF-VER-01). Sin URL, la
# API no inventa un puntaje: cada selfie va a revisión humana.
FACE_MATCH_URL=
FACE_MATCH_API_KEY=
# Face match provider: "rekognition" (Amazon Rekognition CompareFaces reading
# the selfie and main photo from the S3_* bucket — real AWS S3 only, not
# MinIO/R2) or empty (FACE_MATCH_URL if set, otherwise the dev stub).
FACE_MATCH_PROVIDER=
# Rekognition region when it differs from S3_REGION (not offered everywhere).
REKOGNITION_REGION=
# Similarity (0..1) at or above which a selfie with liveness auto-approves.
# Empty or invalid => 0.93.
FACE_MATCH_AUTO_APPROVE=

# --- Icebreakers (optional AI generation; template fallback always on) ---
ICEBREAKER_AI_ENABLED=false

# --- Push notifications (Expo / FCM) ---
EXPO_ACCESS_TOKEN=
FCM_PROJECT_ID=

# --- Payments ---
PAYMENT_PROVIDER=stub
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AZUL_MERCHANT_ID=
AZUL_AUTH_KEY=
APPSTORE_SHARED_SECRET=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# --- Email (Mailpit local / Resend or SMTP in production) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Yugo <hola@yugo.do>"
RESEND_API_KEY=

# --- Product analytics (RF-ADM-12): salt for the irreversible user hash ---
ANALYTICS_SALT=

# --- In-app video calls (RF-CON-12): Daily API key. Empty = feature shown as unavailable ---
DAILY_API_KEY=

# --- Error reporting (RNF-08): Sentry DSNs. Empty = nothing is sent anywhere ---
# API (server errors, 5xx only; never request bodies or headers)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Web (browser errors; read at runtime by the web service, no rebuild needed)
SENTRY_DSN_WEB=
# Mobile: EXPO_PUBLIC_SENTRY_DSN in eas.json / EAS secrets (needs a new native build)

# --- Timezone for daily limits (RF-DES-05) ---
APP_TIMEZONE=America/Santo_Domingo

# --- Web (Next.js) ---
# API_URL (arriba) la lee el servidor web al servir cada página y manda sobre
# NEXT_PUBLIC_API_URL: en producción basta con API_URL, sin reconstruir.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Demo mode renders the full UI with seeded fixtures when the API is offline
NEXT_PUBLIC_DEMO_MODE=true

# --- Mobile (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_DEMO_MODE=true
