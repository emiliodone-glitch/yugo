{
  "name": "yugo",
  "private": true,
  "version": "0.1.0",
  "description": "Yugo — Unidos en la misma fe. Dating with purpose, community and events for Christians.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint \"packages/*/src/**/*.ts\" \"apps/api/src/**/*.ts\" && turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:migrate": "pnpm --filter @yugo/api db:migrate",
    "db:seed": "pnpm --filter @yugo/api db:seed",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "turbo": "^2.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "argon2",
      "sharp",
      "unrs-resolver"
    ]
  }
}
